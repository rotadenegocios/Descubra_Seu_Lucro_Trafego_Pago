# Configure uma destas conexões no ambiente de hospedagem.
DATABASE_URL=

# Banco exclusivo desta pagina dentro do projeto Neon conectado.
LEADS_DATABASE_NAME=leads_descubra_seu_lucro

# Opcional: use uma URL completa exclusiva em vez de DATABASE_URL + nome acima.
LEADS_DATABASE_URL=

# Alternativa ao banco Neon:
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# --- Rastreio (cliente: entra no bundle, use apenas IDs publicos) ---
VITE_TRACKING_ENABLED=false
VITE_SITE_ID=descubra-seu-lucro
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
# advanced: gtag carrega com consentimento negado. basic: nada carrega antes do aceite.
VITE_CONSENT_MODE=advanced
VITE_TRACKING_DEBUG=false

# --- Rastreio (servidor: nunca use o prefixo VITE_) ---
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
# Preencher apenas durante a validacao no Events Manager.
META_TEST_EVENT_CODE=
# String aleatoria usada no hash do external_id.
TRACKING_SALT=
# Sufixos de origem aceitos pelo /api/track, separados por virgula. Vazio usa o padrao.
TRACKING_ALLOWED_ORIGINS=
